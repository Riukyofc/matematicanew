// MathEduca — Schema Relacional Completo
// PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTENTICAÇÃO & RBAC
// ============================================================

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(STUDENT)
  avatarUrl     String?
  xp            Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relações — Professor
  classesTeaching Class[]        @relation("TeacherClasses")

  // Relações — Aluno
  enrollments     Enrollment[]
  quizAttempts    QuizAttempt[]
  achievements    UserAchievement[]
  infractions     Infraction[]   @relation("StudentInfractions")

  // Relações — Professor aplicando penalidade
  appliedInfractions Infraction[] @relation("AppliedByTeacher")

  @@map("users")
}

// ============================================================
// TURMAS & MATRÍCULAS
// ============================================================

model Class {
  id        String   @id @default(cuid())
  name      String
  grade     Int      // 6, 7, 8 ou 9
  year      Int      // Ano letivo (ex: 2026)
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher     User         @relation("TeacherClasses", fields: [teacherId], references: [id])
  enrollments Enrollment[]

  @@map("classes")
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  enrolledAt DateTime @default(now())

  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@map("enrollments")
}

// ============================================================
// TRILHA DE APRENDIZADO & AULAS
// ============================================================

model LearningTrack {
  id          String   @id @default(cuid())
  title       String
  description String?
  grade       Int      // Série alvo (6-9)
  order       Int      @default(0)
  iconUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]

  @@map("learning_tracks")
}

model Lesson {
  id               String   @id @default(cuid())
  trackId          String
  title            String
  description      String?
  videoUrl         String?           // URL do YouTube/Vimeo ou upload direto
  videoProvider    VideoProvider?     // YOUTUBE, VIMEO, UPLOAD
  richTextContent  String?  @db.Text // Conteúdo formatado (HTML/Markdown)
  order            Int      @default(0)
  minWatchTimeSec  Int      @default(300)  // Tempo mínimo (5 min padrão)
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  track   LearningTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  quiz    Quiz?

  @@map("lessons")
}

enum VideoProvider {
  YOUTUBE
  VIMEO
  UPLOAD
}

// ============================================================
// QUIZZES & PERGUNTAS
// ============================================================

model Quiz {
  id              String   @id @default(cuid())
  lessonId        String   @unique   // Relação 1:1 com Lesson
  title           String?
  isTimerEnabled  Boolean  @default(false)
  timeLimitSec    Int?              // Tempo limite em segundos
  maxInfractions  Int      @default(3) // Infrações antes do cancelamento
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id           String   @id @default(cuid())
  quizId       String
  text         String   @db.Text
  imageUrl     String?
  options      Json     // Array de strings: ["opção A", "opção B", "opção C", "opção D"]
  correctIndex Int      // Índice da resposta correta (0-based)
  order        Int      @default(0)
  points       Int      @default(10)
  createdAt    DateTime @default(now())

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@map("questions")
}

// ============================================================
// TENTATIVAS & RESPOSTAS
// ============================================================

model QuizAttempt {
  id              String    @id @default(cuid())
  quizId          String
  studentId       String
  score           Int       @default(0)
  totalPoints     Int       @default(0)
  infractions     Int       @default(0)    // Contador de saídas de tela
  wasCancelled    Boolean   @default(false) // Cancelado por infrações
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  xpEarned        Int       @default(0)

  quiz       Quiz         @relation(fields: [quizId], references: [id])
  student    User         @relation(fields: [studentId], references: [id])
  answers    Answer[]
  infractionLogs Infraction[]

  @@map("quiz_attempts")
}

model Answer {
  id            String   @id @default(cuid())
  attemptId     String
  questionId    String
  selectedIndex Int
  isCorrect     Boolean
  answeredAt    DateTime @default(now())

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("answers")
}

// ============================================================
// GAMIFICAÇÃO — CONQUISTAS
// ============================================================

model Achievement {
  id          String   @id @default(cuid())
  title       String
  description String
  iconUrl     String?
  xpReward    Int      @default(0)
  condition   String   // Descrição da condição (ex: "complete_5_quizzes")
  createdAt   DateTime @default(now())

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// ============================================================
// INFRAÇÕES & PENALIDADES
// ============================================================

enum InfractionType {
  SCREEN_EXIT        // Saída de tela durante quiz
  COPY_ATTEMPT       // Tentativa de copiar texto
  QUIZ_CANCELLED     // Quiz cancelado por infrações
  MANUAL_PENALTY     // Penalidade manual do professor
  XP_RESET           // Reset de XP pelo professor
  GRADE_NULLIFIED    // Nota anulada pelo professor
}

model Infraction {
  id             String         @id @default(cuid())
  studentId      String
  quizAttemptId  String?
  type           InfractionType
  description    String?
  appliedById    String?        // Professor que aplicou (null = automática)
  createdAt      DateTime       @default(now())

  student     User         @relation("StudentInfractions", fields: [studentId], references: [id])
  quizAttempt QuizAttempt? @relation(fields: [quizAttemptId], references: [id])
  appliedBy   User?        @relation("AppliedByTeacher", fields: [appliedById], references: [id])

  @@map("infractions")
}
